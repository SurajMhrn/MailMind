# Copy this file to .env and fill in your values.

# --- LLM (hosted, free Qwen) ---
# groq: free key at https://console.groq.com/keys   (default model qwen/qwen3.8-27b)
# openrouter: free key at https://openrouter.ai/keys (default model qwen/qwen3-235b-a22b:free)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the provider's default model
LLM_MODEL=

# --- Optional embeddings for vector search (any OpenAI-compatible /embeddings endpoint) ---
# Leave blank to use BM25 keyword retrieval, which needs no API.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# --- Email sending (Gmail: use an App Password, https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=
# Reply/bounce checking reads the inbox over IMAP with the same App Password.
IMAP_HOST=imap.gmail.com
# Days after the previous email when follow-up #1, #2, ... are due.
FOLLOWUP_DAYS=4,7

# --- Find openings: website crawling via Apify (https://console.apify.com/settings/integrations) ---
APIFY_API_TOKEN=
